# Copy to .env.local and fill in. Never commit real keys.

# Gemini API key for receipt scanning. Get a free key at Google AI Studio:
# https://aistudio.google.com/apikey
# NOTE: on the free tier, Google may use inputs (including receipt photos)
# to improve its products. Leave blank to disable scanning (manual entry still works).
GEMINI_API_KEY=

# Gemini model used for receipt extraction.
GEMINI_MODEL=gemini-3.1-flash-lite

# Public URL of the deployed site, used for SEO (canonical URLs, sitemap,
# Open Graph link previews). e.g. https://splitsnap.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase, for shareable live bills (optional). Leave blank and the app still
# works in solo mode; "Share with the table" then says sharing isn't set up.
# Both values are public by design: access is enforced by Row Level Security.
# Find them in the Supabase dashboard under Project Settings > API.
# NEVER put the service-role (secret) key in this app.
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects call it the "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy "anon" key. Used only if the publishable key is blank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
